{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git remote*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git show*)",
      "Bash(docker *)",
      "Bash(mvn *)",
      "Bash(npm *)",
      "Bash(gh auth status*)",
      "Bash(gh repo create*)",
      "Bash(gh repo view*)",
      "Bash(java *)",
      "Bash(node *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(gh repo delete*)",
      "Bash(rm -rf*)"
    ]
  }
}
